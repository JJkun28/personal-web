---
// 项目详情页：每个项目生成一页 projects/<slug>.html，内容来自 src/data/projects.ts
import Page from '../../layouts/Page.astro';
import { projects, type Project } from '../../data/projects';
import { site } from '../../data/site';
import { rootOf } from '../../lib/paths';
import Gallery from '../../components/Gallery.astro';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const root = rootOf(Astro.url);
const { cover } = project;
---

<Page title={`${project.title} · ${site.title}`} description={project.summary}>
  <main class="container detail">
    {/* 打开详情页第一眼看到的永远是封面；桌宠合集没有封面图，用三只桌宠代替 */}
    {
      cover && (
        <div class:list={['hero', { contain: cover.fit === 'contain' }]} style={`--hero-bg: ${cover.bg ?? 'var(--surface-2)'}`}>
          <img
            src={`${root}${cover.src}`}
            alt={cover.alt}
            width={cover.width}
            height={cover.height}
            class:list={{ pixel: cover.pixel }}
            decoding="async"
          />
        </div>
      )
    }
    {
      project.pets && (
        <ul class="pets">
          {project.pets.map((pet) => (
            <li>
              <a href={pet.href} target="_blank" rel="noopener">
                <img src={`${root}${pet.image}`} alt={`${pet.name}像素桌宠`} decoding="async" />
                <span class="cn">{pet.name}</span>
                <span class="en">{pet.en} ↗</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {/* 滑到它碰到顶部栏时，顶部栏切换成同样的「返回项目」（见 TopBar.astro） */}
    <a class="back" href={`${root}index.html#projects`} data-back data-back-anchor>← 返回项目</a>

    <header>
      <h1>{project.title}</h1>
      {project.subtitle && <p class="subtitle">{project.subtitle}</p>}
      <p class="summary">{project.summary}</p>
      <ul class="tags">
        {project.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>

    {/* 成品效果放在正文前面，先让人看到项目最后做出来是什么样 */}
    {project.showcase && <Gallery title={project.showcaseTitle} items={project.showcase} root={root} />}

    <div class="text">
      {project.details.map((p) => <p>{p}</p>)}
    </div>

    {project.gallery && <Gallery title={project.galleryTitle} items={project.gallery} root={root} />}

    {
      (project.href || project.note) && (
        <footer>
          {project.href && (
            <a class="go" href={project.href} target="_blank" rel="noopener">
              在 {project.linkLabel ?? '网页'} 查看 ↗
            </a>
          )}
          {project.note && <p class="note">{project.note}</p>}
        </footer>
      )
    }
  </main>
</Page>

<style>
  .detail {
    max-width: 880px;
    padding-top: 24px;
    padding-bottom: 64px;
  }

  .hero {
    overflow: hidden;
    margin-bottom: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--hero-bg);
  }

  .hero img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero.contain {
    padding: 24px 16px;
  }

  .hero.contain img {
    max-width: 720px;
    margin: 0 auto;
  }

  .back {
    display: inline-block;
    margin-left: -10px;
    padding: 4px 10px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--muted);
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .back:hover {
    background: var(--surface-2);
    color: var(--text);
    text-decoration: none;
  }

  header {
    margin: 16px 0 28px;
  }

  h1 {
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    line-height: 1.3;
    margin: 0;
  }

  .subtitle {
    margin: 4px 0 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
  }

  .summary {
    margin: 16px 0 0;
    font-size: 1.05rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .pixel,
  .pets img {
    image-rendering: pixelated;
  }

  .pets {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
  }

  .pets a {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
    transition: transform 0.2s ease;
  }

  .pets a:hover {
    transform: scale(0.98);
    text-decoration: none;
  }

  .pets img {
    height: 110px;
    width: auto;
    margin-bottom: 10px;
  }

  .cn {
    font-weight: 600;
    color: var(--text);
  }

  .en {
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .text {
    margin-bottom: 28px;
  }

  .text p {
    margin: 0 0 14px;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .go {
    display: inline-block;
    padding: 7px 16px;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font-size: 0.9rem;
    font-weight: 500;
    transition: opacity 0.15s;
  }

  .go:hover {
    opacity: 0.85;
    text-decoration: none;
  }

  .note {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .pets a {
      transition: none;
    }
    .pets a:hover {
      transform: none;
    }
  }
</style>

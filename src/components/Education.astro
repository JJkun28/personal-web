---
import { education } from '../data/experience';
---

<section id="education">
  <div class="container">
    <h2 class="section-title">教育</h2>
    <ul class="list">
      {
        education.map((item) => (
          <li class="row">
            <div>
              <h3>{item.school}</h3>
              <p class="degree">{item.degree}</p>
              {item.detail && <p class="detail">{item.detail}</p>}
            </div>
            <span class="period">{item.period}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }

  h3 {
    font-size: 1.05rem;
    margin: 0;
    line-height: 1.5;
  }

  .degree {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 0.93rem;
  }

  .detail {
    margin: 2px 0 0;
    font-size: 0.85rem;
    color: var(--accent);
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
    white-space: nowrap;
  }
</style>

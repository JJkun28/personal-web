---
// 联系：邮箱、GitHub、微信三张卡片。邮箱和微信可以一键复制，GitHub 点击打开主页。
import { site } from '../data/site';
const year = new Date().getFullYear();
const githubUser = site.github.replace(/^https?:\/\/github\.com\//, '');
---

<section id="contact">
  <div class="container">
    <h2 class="section-title">联系</h2>
    <p class="lead">欢迎通过以下方式联系我。</p>
    <ul class="cards">
      <li class="card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
            <path d="m4 7 8 6 8-6"></path>
          </svg>
        </span>
        <span class="label">邮箱</span>
        <a class="value" href={`mailto:${site.email}`}>{site.email}</a>
        <button class="copy" type="button" data-copy={site.email} data-label="复制邮箱">复制邮箱</button>
      </li>

      <li class="card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
          </svg>
        </span>
        <span class="label">GitHub</span>
        <a class="value" href={site.github} target="_blank" rel="noopener">{githubUser}</a>
        <a class="copy" href={site.github} target="_blank" rel="noopener">打开主页 ↗</a>
      </li>

      <li class="card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9.5 4C5.4 4 2 6.7 2 10c0 1.9 1.1 3.6 2.9 4.7L4.3 17l2.7-1.4c.8.2 1.6.4 2.5.4"></path>
            <path d="M16 9.5c3.3 0 6 2.2 6 4.9 0 1.5-.8 2.8-2.1 3.7l.5 1.9-2.2-1.1c-.7.2-1.4.3-2.2.3-3.3 0-6-2.2-6-4.8s2.7-4.9 6-4.9z"></path>
            <circle cx="7" cy="8.6" r=".6" fill="currentColor"></circle>
            <circle cx="11.5" cy="8.6" r=".6" fill="currentColor"></circle>
            <circle cx="14" cy="13.6" r=".55" fill="currentColor"></circle>
            <circle cx="18" cy="13.6" r=".55" fill="currentColor"></circle>
          </svg>
        </span>
        <span class="label">微信</span>
        <span class="value">{site.wechat}</span>
        <button class="copy" type="button" data-copy={site.wechat} data-label="复制微信号">复制微信号</button>
      </li>
    </ul>
  </div>
</section>

<footer>
  <div class="container">
    <span>© {year} {site.name} {site.alias}</span>
    <a href={site.github} target="_blank" rel="noopener">GitHub</a>
  </div>
</footer>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('#contact button[data-copy]')) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.textContent = '已复制 ✓';
      } catch {
        btn.textContent = '复制失败，请手动选择';
      }
      setTimeout(() => (btn.textContent = btn.dataset.label ?? '复制'), 1600);
    });
  }
</script>

<style>
  .lead {
    color: var(--muted);
    margin: 0 0 16px;
  }

  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.15s;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }

  .icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 6px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .label {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .value {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--text);
    overflow-wrap: anywhere;
    margin-bottom: 8px;
  }

  a.value:hover {
    color: var(--accent);
  }

  .copy {
    margin-top: auto;
    padding: 4px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--muted);
    font: inherit;
    font-size: 0.8rem;
    line-height: 1.5;
    cursor: pointer;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      color 0.15s;
  }

  .copy:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--surface);
    text-decoration: none;
  }

  .copy:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 24px 0 32px;
    font-size: 0.85rem;
    color: var(--muted);
  }

  footer .container {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  footer a {
    color: var(--muted);
  }
</style>

---
import { pets } from '../data/projects';

const count = pets.items.length;
const mid = (count - 1) / 2;
---

<article class="card pets" tabindex="0" aria-label={`${pets.title}，共 ${count} 只`}>
  <div class="stage">
    {
      pets.items.map((pet, i) => (
        <a
          class="pet"
          href={pet.href}
          target="_blank"
          rel="noopener"
          style={`--o: ${i - mid}; --z: ${10 - Math.abs(i - mid)}`}
        >
          <img src={pet.image} alt={`${pet.name}像素桌宠`} loading="lazy" decoding="async" />
          <span class="label">
            <span class="cn">{pet.name}</span>
            <span class="en">{pet.en}</span>
          </span>
        </a>
      ))
    }  </div>
  <div class="body">
    <h3>
      {pets.title}
      <span class="subtitle">{pets.subtitle}</span>
    </h3>
    <p class="desc">{pets.desc}</p>
    <ul class="tags">
      {pets.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <p class="note">{pets.note}，点击桌宠查看图鉴页。</p>
  </div>
</article>

<style>
  .card {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.15s;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--accent);
  }

  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .stage {
    position: relative;
    height: 240px;
    background-color: var(--surface-2);
    background-image: radial-gradient(var(--border) 1px, transparent 1px);
    background-size: 14px 14px;
  }

  /* 收起：叠成一摞，略微错开、倾斜 */
  .pet {
    position: absolute;
    top: 50%;
    left: calc(50% + var(--o) * 34px);
    z-index: var(--z);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    transform: translate(-50%, -58%) rotate(calc(var(--o) * 9deg)) scale(0.92);
    transition:
      left 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
    text-decoration: none;
  }

  .pet img {
    display: block;
    height: 128px;
    width: auto;
    image-rendering: pixelated;
    filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.18));
  }

  .label {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.3;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.25s,
      transform 0.25s;
    white-space: nowrap;
  }

  .label .cn {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
  }

  .label .en {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .pet:hover .cn,
  .pet:focus-visible .cn {
    color: var(--accent);
  }

  /* 展开：三只并排摆开，显示名字 */
  .card:hover .pet,
  .card:focus-within .pet {
    left: calc(50% + var(--o) * min(30%, 240px));
    transform: translate(-50%, -50%) rotate(0deg) scale(1);
  }

  .card:hover .label,
  .card:focus-within .label {
    opacity: 1;
    transform: none;
    transition-delay: 0.15s;
  }

  /* 没有鼠标悬停的设备（手机、平板）：直接显示展开状态 */
  @media (hover: none) {
    .pet {
      left: calc(50% + var(--o) * 31%);
      transform: translate(-50%, -50%);
    }
    .pet img {
      height: 92px;
    }
    .label {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 479px) {
    .stage {
      height: 200px;
    }
    .pet img {
      height: 84px;
    }
  }

  .body {
    padding: 18px 20px 20px;
  }

  h3 {
    font-size: 1.15rem;
    margin: 0 0 8px;
    line-height: 1.4;
  }

  .subtitle {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--muted);
  }

  .desc {
    font-size: 0.93rem;
    color: var(--muted);
    margin: 0 0 14px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .note {
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .pet,
    .label {
      transition: none;
    }
  }
</style>

---
import { experience } from '../data/experience';
---

<section id="experience">
  <div class="container">
    <h2 class="section-title">经历</h2>
    <ol class="timeline">
      {
        experience.map((item) => (
          <li class="item">
            <div class="head">
              <h3>{item.role}</h3>
              <span class="period">{item.period}</span>
            </div>
            <p class="org">
              {item.org} · {item.place}
            </p>
            <ul class="points">
              {item.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--border);
  }

  .item {
    position: relative;
    padding: 0 0 32px 24px;
  }

  .item:last-child {
    padding-bottom: 0;
  }

  .item::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 9px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .item:first-child::before {
    background: var(--accent);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
  }

  h3 {
    font-size: 1.1rem;
    margin: 0;
    line-height: 1.5;
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .org {
    font-size: 0.9rem;
    color: var(--accent);
    margin: 2px 0 10px;
  }

  .points {
    list-style: disc;
    margin: 0;
    padding-left: 1.1em;
    color: var(--muted);
    font-size: 0.93rem;
  }

  .points li + li {
    margin-top: 4px;
  }
</style>

---
import { site } from '../data/site';
---

<header class="hero" id="top">
  <div class="container">
    <h1 class="visually-hidden">{site.name} {site.alias}</h1>
    <nav class="links" aria-label="快速链接">
      <a href="#projects">项目</a>
      <a href="#skills">技能</a>
      <a href={site.github} target="_blank" rel="noopener">GitHub ↗</a>
    </nav>
  </div>
</header>

<style>
  .hero {
    padding: 32px 0 28px;
    border-bottom: 1px solid var(--border);
  }

  /* 标题只给读屏软件和搜索引擎看，名字已经显示在顶部栏 */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-left: -10px;
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  .links a {
    padding: 4px 10px;
    border-radius: 999px;
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .links a:hover {
    background: var(--accent-soft);
    text-decoration: none;
  }

  @media (max-width: 639px) {
    .hero {
      padding: 24px 0 20px;
    }
  }
</style>

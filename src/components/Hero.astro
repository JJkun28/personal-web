---
import { site } from '../data/site';
---

<header class="hero">
  <div class="container">
    <p class="kicker">{site.school}</p>
    <h1>{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
    <nav class="links" aria-label="快速链接">
      <a href="#projects">项目</a>
      <a href="#skills">技能</a>
      <a href="#contact">联系</a>
      <a href={site.github} target="_blank" rel="noopener">GitHub ↗</a>
    </nav>
  </div>
</header>

<style>
  .hero {
    padding: 96px 0 56px;
    border-bottom: 1px solid var(--border);
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent);
    margin: 0 0 8px;
  }

  h1 {
    font-size: clamp(2.6rem, 8vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }

  .tagline {
    font-size: clamp(1.1rem, 3.2vw, 1.35rem);
    color: var(--muted);
    margin: 0 0 32px;
    max-width: 32em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  @media (max-width: 639px) {
    .hero {
      padding: 64px 0 40px;
    }
  }
</style>

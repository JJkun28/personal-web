---
import { skills } from '../data/skills';
---

<section id="skills">
  <div class="container">
    <h2 class="section-title">技能</h2>
    <dl class="skills">
      {
        skills.map((group) => (
          <div class="row">
            <dt>{group.name}</dt>
            <dd>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .skills {
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .row {
    display: grid;
    grid-template-columns: 7em 1fr;
    gap: 8px 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }

  dt {
    font-weight: 600;
  }

  dd {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 2px 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
  }

  @media (max-width: 479px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>

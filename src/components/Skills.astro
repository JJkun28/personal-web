---
// 技能卡片：小图标 + 技能名 + 具体会什么 + 工具标签 + 用到它的项目（数据在 src/data/skills.ts）
import { skills, type SkillIcon } from '../data/skills';
import { projects } from '../data/projects';

// 24×24 线条图标，颜色跟随主题蓝
const icons: Record<SkillIcon, string> = {
  code: '<path d="M8 7 3 12l5 5M16 7l5 5-5 5M13.5 5l-3 14"/>',
  database:
    '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3"/>',
  chart: '<path d="M4 4v16h16"/><path d="m7.5 15 3.5-4.5 3 2.5 5-6"/>',
  scatter:
    '<path d="M4 4v16h16"/><path d="M7.5 16.5 19 7" stroke-dasharray="1.5 2.5"/><circle cx="8.5" cy="13" r="1.3" fill="currentColor" stroke="none"/><circle cx="12" cy="14.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="13" cy="10" r="1.3" fill="currentColor" stroke="none"/><circle cx="17" cy="11" r="1.3" fill="currentColor" stroke="none"/><circle cx="16.5" cy="6.5" r="1.3" fill="currentColor" stroke="none"/>',
  agent:
    '<circle cx="12" cy="12" r="2.6"/><circle cx="12" cy="4.5" r="1.8"/><circle cx="5" cy="18.5" r="1.8"/><circle cx="19" cy="18.5" r="1.8"/><path d="M12 6.3v3.1M10 13.7l-3.6 3.5M14 13.7l3.6 3.5"/>',
  tool: '<path d="M15 4.5a4.5 4.5 0 0 0-5.6 5.7L4 15.6 8.4 20l5.4-5.4A4.5 4.5 0 0 0 19.5 9l-2.7 2.7-2.9-.7-.7-2.9z"/>',
};

const titleOf = (slug: string) => projects.find((p) => p.slug === slug)?.title ?? slug;
---

<section id="skills">
  <div class="container">
    <h2 class="section-title">技能</h2>
    <ul class="grid">
      {
        skills.map((skill) => (
          <li class="card">
            <div class="head">
              <span class="icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="20"
                  height="20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[skill.icon]}
                />
              </span>
              <h3 class="name">
                {skill.name}
                <span class="en">{skill.en}</span>
              </h3>
            </div>
            <p class="desc">{skill.desc}</p>
            <ul class="tags">
              {skill.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {skill.projects && (
              <p class="used">
                <span class="used-label">用在</span>
                {skill.projects.map((slug) => (
                  <a href={`projects/${slug}.html`}>{titleOf(slug)}</a>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 18px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.15s;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }

  .head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 8px;
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .en {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--muted);
  }

  .desc {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 1px 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface-2);
  }

  .used {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    margin: auto 0 0;
    padding-top: 10px;
    border-top: 1px dashed var(--border);
    font-size: 0.8rem;
  }

  .used-label {
    font-family: var(--font-mono);
    color: var(--muted);
  }

  .used-label::after {
    content: ' →';
  }
</style>
